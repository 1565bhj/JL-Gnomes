{
  "version": 4,
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "compilerPath": "D:/Program Files/mingw/MinGW/bin/gcc.exe",
      "intelliSenseMode": "windows-gcc-x64",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "SUPPORT_MS_EXTENSIONS",
        "CONFIG_RELEASE_ENABLE",
        "CONFIG_CPU_WL82",
        "CONFIG_FREE_RTOS_ENABLE",
        "CONFIG_THREAD_ENABLE",
        "CONFIG_AUDIO_ONCHIP",
        "CONFIG_WIFI_ENABLE",
        "__GCC_PI32V2__",
        "CONFIG_NEW_ECC_ENABLE",
        "CONFIG_EQ_SUPPORT_ASYNC",
        "EQ_CORE_V1",
        "CONFIG_VIDEO_DEC_EN",
        "CONFIG_VIDEO_OSD_EN",
        "CONFIG_AUDIO_ENABLE",
        "CONFIG_JLFAT_ENABLE",
        "CONFIG_RTOS_AND_MM_LIB_CODE_SECTION_IN_SDRAM",
        "CONFIG_NET_ENABLE=1",
        "CONFIG_BT_ENABLE=1",
        "EVENT_HANDLER_NUM_CONFIG=2",
        "EVENT_TOUCH_ENABLE_CONFIG=0",
        "EVENT_POOL_SIZE_CONFIG=256",
        "CONFIG_EVENT_KEY_MAP_ENABLE=0",
        "TIMER_POOL_NUM_CONFIG=15",
        "APP_ASYNC_POOL_NUM_CONFIG=0",
        "VFS_ENABLE=1",
        "USE_SDFILE_NEW=1",
        "SDFILE_STORAGE=1",
        "VFS_FILE_POOL_NUM_CONFIG=8",
        "VM_MAX_PAGE_ALIGN_SIZE_CONFIG=64*1024",
        "VM_MAX_SECTOR_ALIGN_SIZE_CONFIG=64*1024",
        "VM_ITEM_MAX_NUM=256",
        "CONFIG_TWS_ENABLE",
        "CONFIG_BTCTRLER_TASK_DEL_ENABLE",
        "CONFIG_LMP_CONN_SUSPEND_ENABLE",
        "CONFIG_LMP_REFRESH_ENCRYPTION_KEY_ENABLE",
        "CONFIG_ITEM_FORMAT_VM"
      ],
      "compilerArgs": [
        "-target",
        "pi32v2",
        "-mcpu=r3",
        "-mfprev1",
        "-fms-extensions"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include_lib",
          "${workspaceFolder}/apps",
          "${workspaceFolder}/cpu/wl82"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}