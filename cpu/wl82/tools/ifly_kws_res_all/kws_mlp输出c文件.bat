@echo off
setlocal

set "OUTFILE=ifly_kws_mlp.c"
set "HDRFILE=ifly_kws_mlp.h"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$out='%OUTFILE%'; $hdr='%HDRFILE%';" ^
  "$files=Get-ChildItem -Path . -Filter *.bin -File;" ^
  "if(-not $files){ Write-Host 'No .bin files found.'; exit 1 }" ^
  "$sb=New-Object System.Text.StringBuilder;" ^
  "$hb=New-Object System.Text.StringBuilder;" ^
  "[void]$sb.AppendLine('/* Auto-generated by batch script */');" ^
  "[void]$sb.AppendLine('/* Do not edit manually */');" ^
  "[void]$sb.AppendLine();" ^
  "[void]$sb.AppendLine('#include \"' + $hdr + '\"');" ^
  "[void]$sb.AppendLine();" ^
  "[void]$hb.AppendLine('/* Auto-generated by batch script */');" ^
  "[void]$hb.AppendLine('/* Do not edit manually */');" ^
  "[void]$hb.AppendLine();" ^
  "[void]$hb.AppendLine('#ifndef IFLY_KWS_MLP_H');" ^
  "[void]$hb.AppendLine('#define IFLY_KWS_MLP_H');" ^
  "[void]$hb.AppendLine();" ^
  "[void]$hb.AppendLine('#include \"app_config.h\"');" ^
  "[void]$hb.AppendLine('#ifdef __cplusplus');" ^
  "[void]$hb.AppendLine('extern \"C\" {');" ^
  "[void]$hb.AppendLine('#endif');" ^
  "[void]$hb.AppendLine();" ^
  "[void]$hb.AppendLine('#define IFLY_KWS_MLP_CONST_C');" ^
  "[void]$hb.AppendLine('#ifdef IFLY_KWS_MLP_CONST_C');" ^
  "[void]$hb.AppendLine();" ^
  "foreach($f in $files){" ^
  "  $name=[System.IO.Path]::GetFileNameWithoutExtension($f.Name);" ^
  "  $name=($name -replace '[^A-Za-z0-9_]','_');" ^
  "  $upper=$name.ToUpper();" ^
  "  $bytes=[System.IO.File]::ReadAllBytes($f.FullName);" ^
  "  $len=$bytes.Length;" ^
  "  [void]$sb.AppendLine('/* Source: ' + $f.Name + ' */');" ^
  "  [void]$sb.AppendLine('#ifdef ' + $upper + '_LEN');" ^
  "  [void]$sb.AppendLine('const char ' + $name + '[' + $len + '] = {');" ^
  "  for($i=0;$i -lt $len;$i+=16){" ^
  "    $end=[Math]::Min($i+15,$len-1);" ^
  "    $tokens=@();" ^
  "    for($j=$i;$j -le $end;$j++){ $tokens += ('0x{0:X2}' -f $bytes[$j]) }" ^
  "    $line='    ' + ($tokens -join ', ');" ^
  "    if($end -lt $len-1){ $line += ',' }" ^
  "    [void]$sb.AppendLine($line);" ^
  "  }" ^
  "  [void]$sb.AppendLine('};');" ^
  "  [void]$sb.AppendLine('#endif');" ^
  "  [void]$sb.AppendLine();" ^
  "  [void]$hb.AppendLine('/* Source: ' + $f.Name + ' */');" ^
  "  [void]$hb.AppendLine('#define ' + $upper + '_LEN ' + $len);" ^
  "  [void]$hb.AppendLine('extern const char ' + $name + '[' + $upper + '_LEN];');" ^
  "  if($name.ToLower().EndsWith('keywords')){ [void]$hb.AppendLine('#define IFLY_KEYWORDS ' + $name) }" ^
  "  if($name.ToLower().EndsWith('mlp')){ [void]$hb.AppendLine('#define IFLY_MLP ' + $name) }" ^
  "  [void]$hb.AppendLine();" ^
  "}" ^
  "[void]$hb.AppendLine('#endif');" ^
  "[void]$hb.AppendLine('#ifdef __cplusplus');" ^
  "[void]$hb.AppendLine('}');" ^
  "[void]$hb.AppendLine('#endif');" ^
  "[void]$hb.AppendLine();" ^
  "[void]$hb.AppendLine('#endif /* IFLY_KWS_MLP_H */');" ^
  "[System.IO.File]::WriteAllText($out, $sb.ToString(), (New-Object System.Text.UTF8Encoding($false)));" ^
  "[System.IO.File]::WriteAllText($hdr, $hb.ToString(), (New-Object System.Text.UTF8Encoding($false)));" ^
  "Write-Host ('Done. Output written to ' + $out + ' and ' + $hdr);"

endlocal